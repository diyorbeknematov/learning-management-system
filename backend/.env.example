HTTP_HOST=0.0.0.0
HTTP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=lms
DB_USER=postgres
DB_PASSWORD=pass

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=lms
MINIO_USE_SSL=false
MINIO_PRESIGNED_EXPIRY=15m

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# generate with: openssl rand -hex 32
TOKEN_SECRET=change-me-to-a-long-random-string

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

APP_ENV=dev
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log
LOG_TO_FILE=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@lms.local

RESET_TOKEN_TTL=15m
RESET_PASSWORD_URL=http://localhost:3000/reset-password
CERTIFICATE_VERIFY_URL=http://localhost:8080/api/v1/certificates/verify
CORS_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=
RATE_LIMIT_ENABLED=true

# The first SuperAdmin. Created at start-up when ADMIN_PASSWORD is set and the
# system has no SuperAdmin yet; change the password after the first login.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@lms.local
ADMIN_PASSWORD=
